# Copy to .env and fill in values. Never commit .env to source control.

# --- App database (document list, research runs, reports) -------------------
# If the password contains special characters, URL-encode them (@ becomes %40).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentflow

# --- Vector store (document search) ------------------------------------------
# QDRANT_PATH runs an embedded on-disk Qdrant with no server (single process, local
# development only). Leave it empty and set QDRANT_URL to use a Qdrant server or cloud.
QDRANT_PATH=./qdrant_data
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agentflow_docs
QDRANT_API_KEY=

# "hash" is offline keyword matching (no download); "fastembed" is semantic search
# (downloads a model on first use). Changing it requires re-uploading documents.
EMBEDDING_PROVIDER=hash

# --- Server default LLM -------------------------------------------------------
# Any OpenAI-compatible endpoint. Visitors can override it with their own key in Settings.
GEMINI_API_KEY=
GEMINI_BASE_URL=http://127.0.0.1:8081/v1
GEMINI_MODEL=gemini-3.5-flash

# Optional - operator's own web-search key, used only if SEARCH_FALLBACK_TO_SERVER_KEY=true.
# Users normally add their own Tavily key in Settings. USE_MOCK_SEARCH=true returns fake
# results for development; set it to false in production.
TAVILY_API_KEY=

# Mock toggles. Set to false to use the real service.
USE_MOCK_SQL=false
USE_MOCK_VECTOR_SEARCH=false
USE_MOCK_SEARCH=true

# --- Demo database -------------------------------------------------------------
# A separate, read-only database with sample retail data that visitors can choose in
# Settings. Create an empty database, set this, then run from backend/:
#   PYTHONPATH=. python demo/seed_demo_db.py
# Leave empty to hide the demo option.
DEMO_DATABASE_URL=

# --- Environment and security -------------------------------------------------
# "production" turns on secure cookies (__Host- prefix), HTTPS redirect, HSTS, hides the
# /docs pages, and refuses to start if ALLOW_PRIVATE_HOSTS is true.
ENVIRONMENT=development
# Public URL(s) of the frontend, comma-separated, no trailing slash. Browser requests from
# any other origin are rejected (CSRF protection).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Login lifetime in days.
SESSION_DAYS=14
# Trust X-Forwarded-For / X-Forwarded-Proto. Enable only behind a proxy you control
# (Render, Fly, Railway...); otherwise every user shares one rate limit and HTTPS can't be detected.
TRUST_PROXY_HEADERS=false
# Allow user-supplied LLM/database hosts on private or loopback addresses.
# Local development only; must be false in production (SSRF protection).
ALLOW_PRIVATE_HOSTS=true

# --- What users must bring themselves ------------------------------------------
# Users must supply their own LLM key; the server default above is never used.
REQUIRE_USER_LLM_KEY=false
# The SQL agent only runs against a database the user chose (their own or the demo),
# never the app database. Set to true in production.
REQUIRE_CUSTOMER_DB=false
# Use TAVILY_API_KEY above when a user hasn't entered their own. Off: web search is skipped
# for users without a key, so it never spends your quota.
SEARCH_FALLBACK_TO_SERVER_KEY=false

# --- Rate limits and quotas (per client IP, per server process) -----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_QUERY_PER_MINUTE=5
RATE_LIMIT_QUERY_PER_HOUR=30
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_TEST_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_HOUR=5
MAX_CONCURRENT_RUNS_PER_VISITOR=2
MAX_UPLOAD_MB=10

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentflow-ai
LANGSMITH_TRACING=false
