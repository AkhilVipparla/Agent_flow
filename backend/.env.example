# Copy to .env and fill in values. Never commit .env to source control.

# --- App database (document list, research runs, reports) -------------------
# If the password contains special characters, URL-encode them (@ becomes %40).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentflow

# --- Vector store (document search) ------------------------------------------
# QDRANT_PATH runs an embedded on-disk Qdrant with no server (single process, local
# development only). Leave it empty and set QDRANT_URL to use a Qdrant server or cloud.
QDRANT_PATH=./qdrant_data
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agentflow_docs
QDRANT_API_KEY=

# "hash" is offline keyword matching (no download); "fastembed" is semantic search
# (downloads a model on first use). Changing it requires re-uploading documents.
EMBEDDING_PROVIDER=hash

# --- Server default LLM -------------------------------------------------------
# Any OpenAI-compatible endpoint. Visitors can override it with their own key in Settings.
GEMINI_API_KEY=
GEMINI_BASE_URL=http://127.0.0.1:8081/v1
GEMINI_MODEL=gemini-3.5-flash

# Optional - real web search. Leave empty and keep USE_MOCK_SEARCH=true to use mock results.
TAVILY_API_KEY=

# Mock toggles. Set to false to use the real service.
USE_MOCK_SQL=false
USE_MOCK_VECTOR_SEARCH=false
USE_MOCK_SEARCH=true

# --- Demo database -------------------------------------------------------------
# A separate, read-only database with sample retail data that visitors can choose in
# Settings. Create an empty database, set this, then run from backend/:
#   PYTHONPATH=. python demo/seed_demo_db.py
# Leave empty to hide the demo option.
DEMO_DATABASE_URL=

# --- Public deployment ---------------------------------------------------------
# Visitors must supply their own LLM key; the server default above is never used.
REQUIRE_USER_LLM_KEY=false
# The SQL agent only runs against a database the visitor chose (their own or the demo),
# never the app database. Set to true in production, or SQL can read other visitors' reports.
REQUIRE_CUSTOMER_DB=false
# Every request must carry a valid X-Visitor-Id. The browser sends one automatically.
REQUIRE_VISITOR_ID=false
# Allow visitor-supplied LLM/database hosts on private or loopback addresses.
# Local development only; must be false in production (SSRF protection).
ALLOW_PRIVATE_HOSTS=true
# Trust X-Forwarded-For for the client IP. Enable only behind a proxy you control,
# otherwise every visitor shares one rate limit.
TRUST_PROXY_HEADERS=false

# --- Rate limits and quotas (per client IP, per server process) -----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_QUERY_PER_MINUTE=5
RATE_LIMIT_QUERY_PER_HOUR=30
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_TEST_PER_MINUTE=10
MAX_CONCURRENT_RUNS_PER_VISITOR=2
MAX_UPLOAD_MB=10

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentflow-ai
LANGSMITH_TRACING=false
